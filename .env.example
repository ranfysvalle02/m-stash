# Copy to .env and replace every placeholder before starting Compose.
MONGO_ROOT_USERNAME=mstash
MONGO_ROOT_PASSWORD=replace-with-a-unique-database-password
MONGO_DB=app_db
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=m-stash
JWT_AUDIENCE=m-stash
TRUST_PROXY=false
METRICS_TOKEN=replace-with-a-unique-metrics-token-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:3000
PORT=4000
