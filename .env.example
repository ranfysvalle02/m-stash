# Copy to .env and replace every placeholder before starting Compose.
MONGO_DB=app_db
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=m-stash
JWT_AUDIENCE=m-stash
TRUST_PROXY=false
# Set true when serving over HTTPS so session cookies carry the Secure attribute.
SESSION_COOKIE_SECURE=false
# Authorizes POST /v1/apps to provision applications. Apps carry their own admins and secret keys.
PLATFORM_TOKEN=replace-with-a-platform-token-at-least-32-characters
METRICS_TOKEN=replace-with-a-unique-metrics-token-at-least-32-characters
ALLOWED_ORIGINS=
PORT=4000
# Enable the in-process webhook delivery worker that drains the outbox to registered endpoints.
WEBHOOK_DELIVERY=false
WEBHOOK_POLL_INTERVAL=5s
WEBHOOK_MAX_ATTEMPTS=6
# Seeds a storytelling public demo into /public on boot. Default on; set off to ship a clean deployment.
DEMO_DATA=on
