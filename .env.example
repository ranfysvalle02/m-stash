# Copy to .env and replace every placeholder before starting Compose.
MONGO_DB=app_db
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=m-stash
JWT_AUDIENCE=m-stash
TRUST_PROXY=false
# Set true when serving over HTTPS so session cookies carry the Secure attribute.
SESSION_COOKIE_SECURE=false
# Authorizes POST /v1/apps to provision applications. Apps carry their own admins and secret keys.
PLATFORM_TOKEN=replace-with-a-platform-token-at-least-32-characters
METRICS_TOKEN=replace-with-a-unique-metrics-token-at-least-32-characters
ALLOWED_ORIGINS=
PORT=4000
# Enable the in-process webhook delivery worker that drains the outbox to registered endpoints.
WEBHOOK_DELIVERY=false
WEBHOOK_POLL_INTERVAL=5s
WEBHOOK_MAX_ATTEMPTS=6
# Seeds a storytelling public demo into /public on boot. Default on; set off to ship a clean deployment.
DEMO_DATA=on
# Optional "vibe lab": an unauth /vibe page that uses Gemini to sketch an m-stash backend for an app idea.
# Leave GEMINI_API_KEY blank to keep the feature disabled (the endpoint returns 404).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Global daily cap on model generations; past it (or on any model failure) the lab falls back to built-in blueprints.
VIBE_DAILY_LIMIT=500
# How long a vibe's share link, live demo, and .zip starter stay available before MongoDB expires them. Capped at 120h (5 days).
VIBE_SHARE_TTL=72h
# Global cap on live vibe sandbox tenants. Past it the lab still returns a spec and snippets, just without a live demo.
VIBE_MAX_SANDBOXES=1000
# Canonical public origin (e.g. https://m-stash.example). When set, it overrides the request host for vibe links, previews, and zips.
PUBLIC_BASE_URL=
# Blank "try it live" sandbox for the guide: POST /v1/try provisions a real, empty, expiring app with a one-time claim token. Set on to enable, off to return 404.
TRY_SANDBOX=off
# How long a try-it sandbox lives before the sweeper deletes it and all its data. Capped at 120h (5 days).
TRY_SANDBOX_TTL=24h
# Self-serve builder signup: when open, anyone can create a free-plan builder account at POST /v1/builder/auth/signup and claim sandboxes. Set off to require operator-provisioned accounts only.
# Note: emails are NOT verified (there is no email transport). The flag and the caps below are the controls.
BUILDER_SIGNUP=off
# Global cap on self-serve builder signups per day (per-IP is additionally limited to 5/hour).
BUILDER_SIGNUP_DAILY_LIMIT=100
# Free-plan quotas applied to self-serve builders and the apps they own/claim. A zero value means unlimited.
FREE_TIER_MAX_APPS=3
FREE_TIER_MAX_USERS=1000
FREE_TIER_MAX_RECORDS=2000
FREE_TIER_MAX_RECORD_BYTES=65536
