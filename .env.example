# Copy to .env and replace every placeholder before starting Compose.
MONGO_DB=app_db
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ISSUER=m-stash
JWT_AUDIENCE=m-stash
TRUST_PROXY=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-an-admin-password-at-least-12-characters
# Optional backend-only credential for shared resource mutations.
SERVICE_TOKEN=
METRICS_TOKEN=replace-with-a-unique-metrics-token-at-least-32-characters
ALLOWED_ORIGINS=
PORT=4000
